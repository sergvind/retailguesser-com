---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Forecast from '../components/Forecast.astro';
import CaseArt from '../components/CaseArt.astro';
import CTA from '../components/CTA.astro';
import { services, caseStudies, testimonials } from '../data/site';
---
<Layout title="Less guesswork. More growth.">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> DATA-DRIVEN. RETAIL-FOCUSED.</p>
      <h1>Less guesswork.<br />More <span class="growth-word">growth.<svg viewBox="0 0 330 13" aria-hidden="true"><path d="M3 9C88 1 213 0 326 5" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" /></svg></span></h1>
      <p class="hero-description">Your data has a story to tell. We turn it into smarter marketing, stronger customer connections, and measurable retail growth.</p>
      <div class="hero-actions"><a class="button" href="/contact.html">Get a free consultation <Icon size={19} /></a><a class="text-link" href="#services">Explore our services <Icon size={17} name="diagonal" /></a></div>
      <div class="hero-reassurance"><span><Icon name="check" size={15} /> Retail expertise</span><span><Icon name="check" size={15} /> Actionable insights</span><span><Icon name="check" size={15} /> Real partnership</span></div>
    </div>
    <Forecast />
  </section>

  <section class="client-strip" aria-label="Businesses featured in our case studies">
    <div class="container"><p>GROWING TOGETHER WITH<br /><strong>FORWARD-THINKING RETAILERS</strong></p><div class="client-names"><span class="client-sycamore"><Icon name="home" size={23} />Sycamore<small>HOME GOODS</small></span><span class="client-gulf"><Icon name="compass" size={27} />GULF COAST<small>OUTDOOR SUPPLY</small></span><span class="client-brightpath"><Icon name="spark" size={25} />brightpath<span class="client-sub">RETAIL GROUP</span></span><span class="client-magnolia"><Icon name="flower" size={25} />magnolia<small>MARKET CO.</small></span></div></div>
  </section>

  <section class="services-section section-pad container" id="services">
    <div class="section-heading"><div><p class="eyebrow">THE RIGHT INSIGHT CHANGES EVERYTHING</p><h2>Good data.<br />Even better decisions.</h2></div><p>From understanding your customers to knowing where to invest next, we help you connect the dots.</p></div>
    <div class="services-grid">{services.map(service => <article class="service-card" id={service.id}><div class="service-card-top"><span class="service-icon"><Icon name={service.icon} size={25} /></span><span class="service-number">/{service.number}</span></div><h3>{service.title}</h3><p>{service.description}</p><a href={`/contact.html?service=${service.id}`} class="service-link">{service.benefit}<Icon name="diagonal" size={20} /></a></article>)}</div>
  </section>

  <section class="results-section section-pad">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">BEHIND THE NUMBERS, REAL PROGRESS</p><h2>Smarter strategy.<br />Measurable impact.</h2></div><a class="text-link" href="/case-studies.html">See all case studies <Icon size={18} /></a></div>
      <div class="featured-cases">{caseStudies.slice(0,2).map(study => <a class="featured-case" href={`/case-studies.html#${study.id}`}><CaseArt kind={study.id} compact /><div class="featured-case-content"><p class="eyebrow">{study.category}</p><h3>{study.headline}</h3><div class="case-result"><div><strong>{study.metrics[0].value}</strong><span>{study.metrics[0].label}</span></div><span class="circle-arrow"><Icon size={21} name="diagonal" /></span></div></div></a>)}</div>
    </div>
  </section>

  <section class="about-preview section-pad container">
    <div class="about-visual" aria-hidden="true"><span class="about-visual-label">A BETTER WAY FORWARD</span><div class="about-visual-grid"></div><div class="path-steps"><span>01 <small>Understand</small></span><span>02 <small>Connect</small></span><span>03 <small>Grow</small><Icon name="diagonal" size={28} /></span></div><div class="about-location"><Icon name="pin" size={16} /> JACKSON, MISSISSIPPI</div></div>
    <div class="about-preview-copy"><p class="eyebrow">YOUR DATA. OUR SHARED AMBITION.</p><h2>More than insights.<br />A partner in your corner.</h2><p>Retailers shouldn’t have to guess what their customers want. That simple belief is why we started Retail Guesser.</p><p>We bring retail experience and data science to the same table, turning complex information into clear recommendations. Then we roll up our sleeves and help you put them to work.</p><a class="text-link" href="/about.html">Get to know Retail Guesser <Icon size={18} /></a></div>
  </section>

  <section class="testimonials-section section-pad container">
    <div class="section-heading"><div><p class="eyebrow">GOOD PEOPLE. GREAT PARTNERSHIPS.</p><h2>Don’t just take our word for it.</h2></div><p>The best part of our work?<br />Helping our clients move forward.</p></div>
    <div class="testimonials-grid">{testimonials.map((item, index) => <figure class="testimonial"><span class="quote-mark" aria-hidden="true">“</span><blockquote>{item.quote}</blockquote><figcaption><span class={`initials initials-${index}`} aria-hidden="true">{item.initials}</span><div><strong>{item.name}</strong><span>{item.role}, {item.company}</span></div></figcaption></figure>)}</div>
  </section>
  <CTA />
</Layout>
