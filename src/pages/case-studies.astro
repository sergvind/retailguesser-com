---
import Layout from '../layouts/Layout.astro';
import CaseArt from '../components/CaseArt.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { caseStudies } from '../data/site';
---
<Layout title="Case studies" description="Explore how Retail Guesser helped Sycamore Home Goods, Gulf Coast Outdoor Supply, Brightpath Retail Group, and Magnolia Market Co. turn data into results.">
  <section class="page-heading container"><p class="eyebrow"><span class="status-dot"></span> OUR WORK, IN THE REAL WORLD</p><h1>Better decisions.<br /><span>Real business impact.</span></h1><p>Every business has its own story. Here’s how we’ve helped<br class="desktop-break" /> retailers write a more successful next chapter.</p></section>
  <nav class="case-jump-nav container" aria-label="Jump to a case study">{caseStudies.map(study => <a href={`#${study.id}`}>{study.company}<Icon size={15} name="diagonal" /></a>)}</nav>
  <div class="case-studies-list container">{caseStudies.map((study, index) => <article class="full-case" id={study.id}><div class="full-case-heading"><p class="eyebrow">CASE STUDY 0{index + 1} <span>/</span> {study.category}</p><h2>{study.headline}</h2><p class="full-case-company">{study.company}</p></div><div class="full-case-body"><CaseArt kind={study.id} /><div class="case-story"><section><h3>The challenge</h3><p>{study.challenge}</p></section><section><h3>Our approach</h3><p>{study.approach}</p></section><section><h3>The impact</h3><p>{study.result}</p></section></div></div><div class="metrics-row">{study.metrics.map(metric => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div></article>)}</div>
  <CTA title="What could your next chapter look like?" text="Every engagement starts with a free discovery call. Let’s explore what’s possible for your business." />
</Layout>
