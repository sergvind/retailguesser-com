---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
const principles = [
  { number: '01', icon: 'shield', title: 'Data integrity', text: 'We never manipulate numbers to tell a comfortable story. Our recommendations are grounded in honest analysis, even when the truth is inconvenient.' },
  { number: '02', icon: 'audience', title: 'Client partnership', text: 'We don’t just hand off deliverables and walk away. We embed with your team, understand your challenges firsthand, and stay accountable for results.' },
  { number: '03', icon: 'trend', title: 'Practical impact', text: 'Every analysis, strategy, and recommendation is designed to move the needle. If it doesn’t drive results, we don’t propose it.' },
];
---
<Layout title="About us" description="Meet Retail Guesser, a Jackson, Mississippi retail marketing consultancy built on honest data, practical insights, and lasting client partnerships.">
  <section class="page-heading container"><p class="eyebrow"><span class="status-dot"></span> A LITTLE ABOUT US</p><h1>Built on data.<br /><span>Driven by your growth.</span></h1><p>We believe better information makes better businesses.<br class="desktop-break" /> And the best results come from working together.</p></section>
  <section class="story-section container">
    <div class="story-art"><div class="story-art-grid" aria-hidden="true"></div><img src="/favicon.svg" width="158" height="158" alt="Retail Guesser’s shopping bag and growth chart symbol" /><h2>Turning guesswork<br />into growth.</h2><span><Icon name="pin" size={16} /> JACKSON, MISSISSIPPI</span></div>
    <div class="story-copy"><p class="eyebrow">OUR STORY</p><h2>A simple idea.<br />A more meaningful impact.</h2><p>RetailGuesser Data L.L.C. was founded on a simple idea: retailers shouldn’t have to guess what their customers want. Too many marketing budgets are wasted on broad campaigns with vague targeting. We started this company to change that, by putting hard data at the center of every marketing decision.</p><p>Based in Jackson, Mississippi, our team brings together retail industry veterans and data scientists who understand both the art and science of selling. We’ve helped brands across the Southeast optimize their marketing spend, launch smarter campaigns, and build deeper connections with their customers.</p><p>What sets us apart is our focus on practical, actionable intelligence. We deliver clear recommendations backed by data, and we stay involved to make sure they work. When you partner with Retail Guesser, you get a team that cares about your bottom line as much as you do.</p></div>
  </section>
  <section class="values-section section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">WHAT WE STAND FOR</p><h2>Good work starts<br />with strong principles.</h2></div><p>Three commitments that shape every analysis, every conversation, and every partnership.</p></div><div class="values-grid">{principles.map(value => <article class="value-card"><span class="service-icon"><Icon name={value.icon} size={27} /></span><span class="value-number">{value.number}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></div></section>
  <section class="approach-section section-pad container"><div class="section-heading"><div><p class="eyebrow">HOW WE WORK</p><h2>From a good question<br />to a clear next step.</h2></div><p>No complicated handoffs. Just a practical process that keeps your business at the center.</p></div><div class="approach-grid"><article><span>01 / LISTEN</span><h3>Start with your business.</h3><p>We get to know your goals, your customers, and the challenges you’re working through.</p></article><article><span>02 / CONNECT</span><h3>Find the useful insight.</h3><p>We connect your retail data to the opportunities that can make a meaningful difference.</p></article><article><span>03 / ACT</span><h3>Put a plan in motion.</h3><p>We help turn recommendations into campaigns, then measure what works and refine what comes next.</p></article></div></section>
  <CTA title="Good things start with a conversation." text="Tell us where you want to go. We’ll help you find a clearer way to get there." />
</Layout>
