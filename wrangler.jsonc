{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retailguesser-website-preview",
  "account_id": "7c5e4209da5497f8a40715ee7d3c9b02",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "env": {
    "production": {
      "name": "retailguesser-website-production",
      "routes": [
        { "pattern": "retailguesser.com/*", "zone_name": "retailguesser.com" }
      ]
    }
  }
}
